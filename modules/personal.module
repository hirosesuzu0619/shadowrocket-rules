#!name = 个人
#!desc = 个人最高优先级规则层。请置于所有其他模块之上。此模块为本地模块，不会被任何自动更新覆盖。启用前请先删除 App 中手工建立的同名分组。

[Proxy Group]
# 不写 policy-path，正则即作用于 Shadowrocket 当前的全部节点（含订阅拉取的节点）。
# US / SG / JP 用 fallback：固定使用当前节点，仅在它不通时才顺延到下一个，不按延迟择优。
# MEXC_TW 用 select 且正则只匹配单个节点，出口完全固定，供交易所类场景使用；换节点改该行正则里的节点名。
# 注释一律单独成行：写在策略组行尾的注释会被并进正则，组内一个节点都匹配不到，引用它的规则会退回首页所选节点。
US = fallback, policy-regex-filter = (?i)(美国|美國|洛杉矶|洛杉磯|圣何塞|聖何塞|西雅图|西雅圖|硅谷|凤凰城|鳳凰城|达拉斯|達拉斯|纽约|紐約|波特兰|波特蘭|拉斯维加斯|拉斯維加斯|United States|\bUSA?\b|🇺🇸), url = http://www.gstatic.com/generate_204, interval = 600, timeout = 5
MEXC_TW = select, policy-regex-filter = (?i)^台湾1$
SG = fallback, policy-regex-filter = (?i)(新加坡|狮城|獅城|星加坡|Singapore|\bSG\b|🇸🇬), url = http://www.gstatic.com/generate_204, interval = 600, timeout = 5
JP = fallback, policy-regex-filter = (?i)(日本|东京|東京|大阪|名古屋|埼玉|川日|沪日|滬日|Japan|\bJP\b|🇯🇵), url = http://www.gstatic.com/generate_204, interval = 600, timeout = 5

[Rule]
# ——手工添加 ——

# —— siri ai ——
# 格式: DOMAIN-SUFFIX,域名,US
# 精确匹配用 DOMAIN, 需要直连写 DIRECT, 需要屏蔽写 REJECT
DOMAIN,guzzoni.apple.com,US
DOMAIN,mask-api.fe.apple-dns.net,US
DOMAIN,mask-api.icloud.com,US
DOMAIN,mask-t.apple-dns.net,US
DOMAIN,mask.apple-dns.net,US
DOMAIN-SUFFIX,smoot.apple.com,US
DOMAIN-SUFFIX,apple-relay.apple.com,US
DOMAIN-SUFFIX,apple-relay.cloudflare.com,US
DOMAIN-SUFFIX,apple-relay.fastly-edge.com,US
DOMAIN-SUFFIX,apple-relay.mask.apple-dns.net,US
DOMAIN-SUFFIX,cp4.cloudflare.com,US
DOMAIN-SUFFIX,gspe1-ssl.ls.apple.com,US
DOMAIN-SUFFIX,gateway.icloud.com,US
DOMAIN-SUFFIX,ls.apple.com,US
DOMAIN-SUFFIX,mask-h2.icloud.com,US
DOMAIN-SUFFIX,mask.icloud.com,US
DOMAIN-SUFFIX,apps.mzstatic.com,US
DOMAIN-KEYWORD,siri,US

# —— MEXC ——
# 交易所主域与镜像域
DOMAIN-SUFFIX,mexc.com,MEXC_TW
DOMAIN-SUFFIX,flytogarden.com,MEXC_TW
DOMAIN-SUFFIX,hotbookzone.com,MEXC_TW
DOMAIN-SUFFIX,greentreeone.com,MEXC_TW
DOMAIN-SUFFIX,coldbookfly.ru,MEXC_TW
DOMAIN-SUFFIX,dgshen.com,MEXC_TW
# 自有监控与埋点：sentry 错误上报、watchman SDK、trochilus
DOMAIN-SUFFIX,gotoda.co,MEXC_TW
# 推送：EngageLab（极光海外版）的三套域名
DOMAIN-SUFFIX,engagelab.cc,MEXC_TW
DOMAIN-SUFFIX,theengagelab.com,MEXC_TW
DOMAIN-SUFFIX,engage7.com,MEXC_TW
DOMAIN-SUFFIX,engageforce.net,MEXC_TW
DOMAIN-SUFFIX,ecbsn.com,MEXC_TW
# 归因：AppsFlyer
DOMAIN-SUFFIX,appsflyersdk.com,MEXC_TW
# App 资源包下载
DOMAIN,s3-app-release.s3.ap-northeast-1.amazonaws.com,MEXC_TW
# 会话期间直连的两个域名：Google 的 ATT 分析域名，以及一台 OVH 法兰克福主机（来源未确认）
DOMAIN-SUFFIX,app-analytics-services-att.com,MEXC_TW
DOMAIN-SUFFIX,protectyouraccess.com,MEXC_TW
# 硬编码直连 IP（华为云新加坡），域名规则匹配不到，只能按 IP 命中
IP-CIDR,119.13.110.238/32,MEXC_TW,no-resolve
IP-CIDR,190.92.208.115/32,MEXC_TW,no-resolve
# MEXC 自有资源域名：静态资源、配置下发与客户端安装包，此前 static 子域直连，真实地址等于直接交给交易所
DOMAIN-SUFFIX,mocortech.com,MEXC_TW

# —— Bybit ——
# api3.bybit.biz 后台心跳此前落在别的模块的通用 PROXY 策略下，出口是台湾2而非本模块钉死的节点，与 MEXC 同样需要固定出口
DOMAIN-SUFFIX,bybit.biz,MEXC_TW
DOMAIN-SUFFIX,bybit.com,MEXC_TW
DOMAIN-SUFFIX,bybitglobal.com,MEXC_TW
# bytick.com 是官方备用 API 域名，bycsi.com 是静态资源/CDN 域名
DOMAIN-SUFFIX,bytick.com,MEXC_TW
DOMAIN-SUFFIX,bycsi.com,MEXC_TW
# 各地区站点（bybit.nl、bybit.eu、bybit-tr 等）名字不一，用关键字兜底
DOMAIN-KEYWORD,bybit,MEXC_TW

# —— 钱包 ——
DOMAIN-SUFFIX,ethenapay-api.co,SG

# —— Meta AI ——
DOMAIN-SUFFIX,meta.ai,US
DOMAIN-SUFFIX,meta.com,US
# hatch.metaaivm.com 是 Meta AI 的后端，不在上面两个后缀之下，此前落到 FINAL 的台湾出口
DOMAIN-SUFFIX,metaaivm.com,US

# —— Claude ——
# 此前落在别的模块的「美国节点」组，在美国1/美国4之间切换；status.claude.com 更是走了 PROXY 的台湾出口
DOMAIN-SUFFIX,claude.ai,US
DOMAIN-SUFFIX,claude.com,US
DOMAIN-SUFFIX,anthropic.com,US
DOMAIN-SUFFIX,claudeusercontent.com,US

# —— OpenAI ——
# chatgpt.com 为主站与 App 接口，oaistatic/oaiusercontent 为静态资源与用户上传/生成的文件
DOMAIN-SUFFIX,openai.com,US
DOMAIN-SUFFIX,chatgpt.com,US
DOMAIN-SUFFIX,oaistatic.com,US
DOMAIN-SUFFIX,oaiusercontent.com,US
DOMAIN-SUFFIX,sora.com,US

# —— Gemini ——
# google.com 整体由别的模块分到「谷歌服务」，这里只挑出 Gemini 相关的子域，用精确匹配避免牵动其他 Google 服务
DOMAIN,gemini.google.com,US
DOMAIN-SUFFIX,gemini.google,US
DOMAIN,aistudio.google.com,US
DOMAIN,notebooklm.google.com,US
DOMAIN,generativelanguage.googleapis.com,US
DOMAIN,proactivebackend-pa.googleapis.com,US
DOMAIN,alkalimakersuite-pa.clients6.google.com,US

# —— Grok ——
DOMAIN-SUFFIX,grok.com,US
DOMAIN-SUFFIX,x.ai,US

# —— X ——
# 此前落在别的模块的「美国节点」组，会在美国1/美国4之间切换，走美国4时冷启动明显偏慢；改走本模块的 US，仅在节点不通时才顺延
DOMAIN-SUFFIX,x.com,US
DOMAIN-SUFFIX,twitter.com,US
# twimg.com 是图片、视频与静态资源，t.co 是短链跳转
DOMAIN-SUFFIX,twimg.com,US
DOMAIN-SUFFIX,t.co,US

# —— 第三方验证/风控 SDK（OKX 活动期间抓到，与 OKX 已有的新加坡出口保持一致）——
# geetest 是独立的验证码厂商，非某个交易所自有；cloudauth-device 是阿里云实人认证，直连会在做身份核验时原样交出真实 IP
DOMAIN-SUFFIX,geetest.com,SG
DOMAIN-SUFFIX,cloudauth-device.aliyuncs.com,SG

# —— 希尔顿 ——
# 会话里 App 的自有域名全部走 FINAL,DIRECT，等于用真实 IP 查房价、登录会员账号；酒店按来源地区做定价与会员政策，出口需与账号注册地一致
# smetric 是 Adobe 的埋点采集域，保持原有的 REJECT，写在前面以免被下面的后缀规则吃掉
DOMAIN-SUFFIX,smetric.hilton.com,REJECT
DOMAIN-SUFFIX,hilton.com,US
# m.hilton.io 是 App 的主 API，hiltonapi.com 是订房/会员接口
DOMAIN-SUFFIX,hilton.io,US
DOMAIN-SUFFIX,hiltonapi.com,US
# Conductrics A/B 分流接口，按 IP 决定给哪套页面；同域的 cdn-v3 子域已被其他模块 REJECT，此处只放 API
DOMAIN,api-hilton.conductrics.net,US
# Clarip 是希尔顿页面加载的隐私同意管理 SDK，按 IP 判定适用法域
DOMAIN,cdn.clarip.com,US
# Rokt 是希尔顿确认页加载的优惠推送平台，会话里同样走了直连
DOMAIN,apps.rokt-api.com,US

# —— Kraken ——
# 15:44 登录时段密集出现，此前落在别的模块的通用 PROXY 策略下、出口是台湾节点，与账号注册地不一致
DOMAIN-SUFFIX,kraken.com,US
# Kraken 专属的客服/帮助中心子域，同一时段反复出现；zendesk.com 根域是公共客服平台，其他公司的子域不受影响
DOMAIN,kraken.zendesk.com,US

# —— Kalshi ——
# mobile-api、api.elections、assets、social-assets 等子域此前全部落在 FINAL 兜底的台湾出口上
DOMAIN-SUFFIX,kalshi.com,US
# 另有几个自有素材桶挂在 amazonaws.com 下、名字是前缀而非后缀（kalshi-public-docs、kalshi-public-images），只能靠关键字命中
DOMAIN-KEYWORD,kalshi,US
