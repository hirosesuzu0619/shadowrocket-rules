#!name = 个人
#!desc = 个人最高优先级规则层。请置于所有其他模块之上。此模块为本地模块，不会被任何自动更新覆盖。启用前请先删除 App 中手工建立的同名分组。

[Proxy Group]
# 不写 policy-path，正则即作用于 Shadowrocket 当前的全部节点（含订阅拉取的节点）。
# 全部分组都用 url-test：按延迟自动择优，tolerance = 50 让延迟相差不到 50 毫秒时不切换，每 300 秒测速一次。
# 代价是出口会在延迟接近的节点之间偶尔切换；交易所也不例外，MEXC、Bybit 可能看到同一账号来自多个地址，触发风控或要求重新验证。
# Bybit 已限制日本用户，所以 BYBIT_TW 在台湾节点里选，没有跟 MEXC 一起改到日本。
# 注释一律单独成行：写在策略组行尾的注释会被并进正则，组内一个节点都匹配不到，引用它的规则会退回首页所选节点。
US = url-test, policy-regex-filter = (?i)(美国|美國|洛杉矶|洛杉磯|圣何塞|聖何塞|西雅图|西雅圖|硅谷|凤凰城|鳳凰城|达拉斯|達拉斯|纽约|紐約|波特兰|波特蘭|拉斯维加斯|拉斯維加斯|United States|\bUSA?\b|🇺🇸), url = http://www.gstatic.com/generate_204, interval = 300, tolerance = 50, timeout = 5
MEXC_JP = url-test, policy-regex-filter = (?i)^(?!.*(倍|剩余|距离|套餐|到期|官网)).*(日本|东京|東京|大阪|名古屋|埼玉|川日|沪日|滬日|Japan|\bJP\b|🇯🇵), url = http://www.gstatic.com/generate_204, interval = 300, tolerance = 50, timeout = 5
BYBIT_TW = url-test, policy-regex-filter = (?i)^(?!.*(倍|剩余|距离|套餐|到期|官网)).*(台湾|台灣|台北|新北|彰化|Taiwan|\bTW\b|🇹🇼), url = http://www.gstatic.com/generate_204, interval = 300, tolerance = 50, timeout = 5
SG = url-test, policy-regex-filter = (?i)(新加坡|狮城|獅城|星加坡|Singapore|\bSG\b|🇸🇬), url = http://www.gstatic.com/generate_204, interval = 300, tolerance = 50, timeout = 5
JP = url-test, policy-regex-filter = (?i)(日本|东京|東京|大阪|名古屋|埼玉|川日|沪日|滬日|Japan|\bJP\b|🇯🇵), url = http://www.gstatic.com/generate_204, interval = 300, tolerance = 50, timeout = 5

[Rule]
# ——手工添加 ——

# —— siri ai ——
# 格式: DOMAIN-SUFFIX,域名,US
# 精确匹配用 DOMAIN, 需要直连写 DIRECT, 需要屏蔽写 REJECT
DOMAIN,guzzoni.apple.com,US
DOMAIN,mask-api.fe.apple-dns.net,US
DOMAIN,mask-api.icloud.com,US
DOMAIN,mask-t.apple-dns.net,US
DOMAIN,mask.apple-dns.net,US
DOMAIN-SUFFIX,smoot.apple.com,US
DOMAIN-SUFFIX,apple-relay.apple.com,US
DOMAIN-SUFFIX,apple-relay.cloudflare.com,US
DOMAIN-SUFFIX,apple-relay.fastly-edge.com,US
DOMAIN-SUFFIX,apple-relay.mask.apple-dns.net,US
DOMAIN-SUFFIX,cp4.cloudflare.com,US
DOMAIN-SUFFIX,gspe1-ssl.ls.apple.com,US
DOMAIN-SUFFIX,gateway.icloud.com,US
DOMAIN-SUFFIX,ls.apple.com,US
DOMAIN-SUFFIX,mask-h2.icloud.com,US
DOMAIN-SUFFIX,mask.icloud.com,US
DOMAIN-SUFFIX,apps.mzstatic.com,US
DOMAIN-KEYWORD,siri,US

# —— Apple Music ——
# 音乐走国内 CDN，直连最快。9 月 30 日的日志里音频流 aod 已是直连，但每首歌开播前的播放授权 play.itunes.apple.com 与服务端点配置 bag.itunes.apple.com 被下面的 Apple TV 规则带去了美国2，播放记录上报 radio-activity 则落到 FINAL 的香港1
# 一首歌要等美国2 取回授权才能开始解密播放，14:55 前后 play 在 35 秒内重连 5 次、14:59 的 bag 每 5 秒重连一次，开播慢、播放卡住就出在这里
# play 与 bag 是 Apple Music 与 Apple TV+ 共用的域名，按域名无法区分 App，这里优先保证 Apple Music，统一直连；写在 Apple TV 规则之前
DOMAIN,play.itunes.apple.com,DIRECT
DOMAIN,bag.itunes.apple.com,DIRECT
DOMAIN,aod.itunes.apple.com,DIRECT
DOMAIN,streamingaudio.itunes.apple.com,DIRECT
DOMAIN,mvod.itunes.apple.com,DIRECT
DOMAIN,radio.itunes.apple.com,DIRECT
DOMAIN,radio-activity.itunes.apple.com,DIRECT
DOMAIN-SUFFIX,music.apple.com,DIRECT

# —— Apple TV App（Apple TV+）——
# 此前没有专门规则，国内 DoH 解析到 Akamai 或 Apple 的国内节点后被 GEOIP,CN 直连，App 直连打不开
# tv.apple.com 后缀涵盖主站与 vod-*.tv.apple.com 视频分片
DOMAIN-SUFFIX,tv.apple.com,US
DOMAIN,tv.applemusic.com,US
# 片单目录、播放鉴权、播放进度同步；只列具体子域，不写 itunes.apple.com 整个后缀，以免牵动 App Store 下载与购买
DOMAIN,uts-api.itunes.apple.com,US
DOMAIN,play-edge.itunes.apple.com,US
DOMAIN,np-edge.itunes.apple.com,US
# HLS 播放清单与视频流
DOMAIN,hls.itunes.apple.com,US
DOMAIN,hls-amt.itunes.apple.com,US
DOMAIN,hls-svod.itunes.apple.com,US
DOMAIN,hls-svod-aoc.itunes.apple.com,US
# 9 月 25 日播放时视频分片已走美国1，但同一会话里的其余接口分散在台湾2 和直连，出口不一致，视频加载不出来
# amp-api.videos.apple.com 是视频内容接口，cma2、pd、bookkeeper（播放进度）此前都不在规则里
# 播放鉴权 play 与服务端点配置 bag 曾一并钉在这里，因与 Apple Music 共用、拖慢音乐开播，已改到上面的 Apple Music 段直连；若 Apple TV+ 再次加载不出来，先看这两个域名
DOMAIN-SUFFIX,videos.apple.com,US
DOMAIN,cma2.itunes.apple.com,US
DOMAIN,pd.itunes.apple.com,US
DOMAIN,bookkeeper.itunes.apple.com,US
# 订阅权益校验走账号专属的 pNN-buy.itunes.apple.com，编号因账号而异，只能用关键字命中；App Store 的购买请求也会随之走 US，下载不受影响
DOMAIN-KEYWORD,-buy.itunes.apple.com,US
# 体育赛事比分与直播信息
DOMAIN,sportskit-api.cdn-apple.com,US

# —— MEXC ——
